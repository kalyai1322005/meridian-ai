# Copy this file to .env and fill in your values:   cp .env.example .env
# .env is git-ignored. Never commit real keys.

# ============================================================
# THE TOGGLE:  local | cloud
#   local -> only GOOGLE_API_KEY is needed. Vectors in Chroma (.meridian/chroma),
#            uploaded PDFs in .meridian/uploads. No AWS account at all.
#   cloud -> Amazon S3 Vectors + S3 + Bedrock embeddings. Fill in the CLOUD block below.
#            AWS credentials come from the normal AWS places (AWS_PROFILE, `aws configure`,
#            or the task role on ECS) - never put access keys in this file.
# ============================================================
APP_MODE=local
ENVIRONMENT=local

# Gemini API key (https://aistudio.google.com/apikey) - needed in BOTH modes
# (unless cloud mode uses LLM_PROVIDER=bedrock for the chat model)
GOOGLE_API_KEY=

# Optional (these are the defaults)
LLM_MODEL_NAME=gemini-3.8-flash          # old name VERTEX_LLM_MODEL_NAME still works
LLM_TEMPERATURE=0.0
LOCAL_EMBEDDING_MODEL_NAME=gemini-embedding-001
# LOCAL_DATA_DIR=./.meridian

# Chat model provider: gemini (default) or bedrock
# LLM_PROVIDER=gemini
# BEDROCK_LLM_MODEL_ID=            # required when LLM_PROVIDER=bedrock (a Bedrock model or inference-profile ID)

# Agent middleware guard-rails (optional, these are the defaults)
# AGENT_MAX_MODEL_CALLS=8
# AGENT_MAX_TOOL_CALLS=6
# AGENT_MAX_RETRIES=2

# ============================================================
# CLOUD block - only read when APP_MODE=cloud
# Every value below is an output of the CloudFormation stack made from infra/aws-bootstrap.yaml
# ============================================================
AWS_REGION=us-east-1
# AWS_PROFILE=default                # if you use a named profile on your laptop

# S3 bucket for the original PDFs and logs
S3_BUCKET_NAME=meridian-ai-docs-<account-id>-us-east-1
S3_PREFIX=uploads/

# S3 Vectors bucket + index (created by the stack)
S3_VECTORS_BUCKET_NAME=meridian-ai-vectors-<account-id>-us-east-1
S3_VECTORS_INDEX_NAME=meridian-docs

# Amazon Titan Text Embeddings V2: 256, 512 or 1024 dimensions. Must match the index (cannot change later).
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_DIMENSIONS=1024
