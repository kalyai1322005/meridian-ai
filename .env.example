# Copy to .env for local development. Never commit real keys.
# Local mode needs only a Gemini API key. AWS cloud mode uses the AWS credential
# chain locally and the ECS task role in production; do not put AWS keys here.
APP_MODE=local
ENVIRONMENT=local

# Local AI models
GOOGLE_API_KEY=
LOCAL_LLM_MODEL_NAME=gemini-3.8-flash
LOCAL_EMBEDDING_MODEL_NAME=gemini-embedding-001
LLM_TEMPERATURE=0.0

# AWS cloud mode settings (APP_MODE=cloud)
AWS_REGION=us-east-1
S3_BUCKET_NAME=
S3_PREFIX=uploads/
OPENSEARCH_URL=
OPENSEARCH_INDEX=meridian-docs
BEDROCK_LLM_MODEL_ID=us.amazon.nova-lite-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# Optional local data folder and agent limits
# LOCAL_DATA_DIR=./.meridian
# AGENT_MAX_MODEL_CALLS=8
# AGENT_MAX_TOOL_CALLS=6
# AGENT_MAX_RETRIES=2
